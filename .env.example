# Credenciais da Iniciadora (client_credentials no gateway em produção)
INITIATOR_CLIENT_ID=
INITIATOR_CLIENT_SECRET=

# URL do core-banking (chamada direta)
CORE_BASE_URL=http://localhost:3000

# URL pública desta iniciadora para receber o redirect de volta da detentora
CALLBACK_URL=http://localhost:8100/callback

# Organização / servidor de autorização (produção)
ORGANISATION_ID=
AUTHORISATION_SERVER_ID=

# Banco local (SQLite). O diretorio e criado automaticamente.
DATABASE_URL=sqlite:///./data/initiator.db

# Porta do servidor FastAPI
PORT=8100

# Autenticacao dos usuarios desta Iniciadora
# Segredo que assina os JWT. Gere um proprio (>= 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do token, em minutos
JWT_EXPIRES_MINUTES=60
# Usuarios pre-cadastrados, semeados a cada start. Formato curto
# "usuario:senha,usuario2:senha2" ou JSON:
#   [{"username": "alice", "password": "s3nh4", "full_name": "Alice Silva"}]
INITIATOR_USERS=alice:alice123,bruno:bruno123
