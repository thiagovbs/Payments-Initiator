# Exemplo de configuração da Iniciadora de Pagamento.
# Copie para .env e ajuste os valores: cp .env.example .env

# --- Identidade da Iniciadora perante a detentora --------------------------

# Client ID da iniciadora (usado no gateway em produção).
INITIATOR_CLIENT_ID=

# Secret da iniciadora. **Deve ser igual ao INITIATOR_SERVICE_SECRET do core**:
# é ele que vai no header x-initiator-key, assina a asserção FIDO da jornada
# JSR e valida a assinatura dos webhooks que a detentora envia.
INITIATOR_CLIENT_SECRET=

# --- Endereços -------------------------------------------------------------

# URL do core-banking (chamada direta).
CORE_BASE_URL=http://localhost:3000

# URL pública desta iniciadora onde a detentora devolve o navegador do titular
# ao fim do enrollment e da aprovação do pagamento.
CALLBACK_URL=http://localhost:8100/callback

# URL pública onde a detentora avisa mudanças de status do consentimento. É o
# que fecha a jornada quando o titular aprova e fecha o navegador sem voltar
# pelo /callback. Use a mesma origem do CALLBACK_URL, com /webhooks/consents.
#
# A origem precisa estar em WEBHOOK_ALLOWED_ORIGINS no core: enviar uma URL que
# ele não aceita faz a criação do consentimento falhar com 400, derrubando a
# jornada. Por isso o padrão é vazio — sem aviso, só a reconciliação do
# GET /payments/{identifier}. Ligue os dois lados juntos.
WEBHOOK_URL=

# Destinos para os quais o /callback pode redirecionar o navegador do titular
# ao fim da jornada (o redirect_uri que o lojista informa). Lista de origens
# separadas por vírgula. Vazio = nenhum redirect ao lojista é permitido.
ENROLLMENT_REDIRECT_ALLOWLIST=

# Organização / servidor de autorização (produção).
ORGANISATION_ID=
AUTHORISATION_SERVER_ID=

# --- Aplicação -------------------------------------------------------------

# Banco local (SQLite). O diretório é criado automaticamente.
DATABASE_URL=sqlite:///./data/initiator.db

# Porta do servidor FastAPI.
PORT=8100

# --- Autenticação dos usuários desta Iniciadora ----------------------------

# Segredo que assina os access tokens. Defina um próprio (>= 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Validade do token, em minutos.
JWT_EXPIRES_MINUTES=60

# Usuários pré-cadastrados, semeados a cada start. Formato curto
# "usuario:senha,usuario2:senha2" ou JSON:
#   [{"username": "alice", "password": "s3nh4", "full_name": "Alice Silva"}]
INITIATOR_USERS=
